# Copy to .env and adjust. All server settings use the FLUX_ prefix.

# Hugging Face model id to serve.
FLUX_MODEL=black-forest-labs/FLUX.2-klein-4B
# Optional: path to a local snapshot directory (overrides the HF cache lookup).
FLUX_MODEL_PATH=
# Model id reported by /v1/models and used by the UI (the request's `model` field is not validated).
FLUX_MODEL_ID=flux.2-klein-4b
# Compute device: auto (cuda -> mps -> cpu) | cuda | mps | cpu
FLUX_DEVICE=auto
# Weights dtype: auto | bfloat16 | float16 | float32
FLUX_DTYPE=auto
# CPU offload strategy: auto | none | model | sequential
FLUX_OFFLOAD=auto
# Transformer weights source: auto (prefer transformer/ dir, fall back to root single file) | diffusers | single_file
FLUX_WEIGHTS=auto

# HTTP bind address and port.
FLUX_HOST=127.0.0.1
FLUX_PORT=8000

# Default number of inference steps (distilled model; 4 is the reference setting).
FLUX_DEFAULT_STEPS=4
# quality -> steps map used when `steps` is not given (JSON; REPLACES the whole default map;
# unknown quality values fall back to FLUX_DEFAULT_STEPS).
FLUX_QUALITY_STEPS={"low": 2, "medium": 4, "high": 8, "auto": 4, "standard": 4, "hd": 8}
# Maximum images per request (n).
FLUX_MAX_N=10
# Maximum output pixels per image (width * height); 4194304 = 2048x2048.
FLUX_MAX_PIXELS=4194304
# Maximum reference images accepted by /v1/images/edits.
FLUX_MAX_REF_IMAGES=16
# Maximum size of each uploaded file in MB (images and mask).
FLUX_MAX_UPLOAD_MB=32
# Maximum concurrent in-flight requests; excess requests get 503 code=overloaded.
FLUX_MAX_IN_FLIGHT=8

# Mount the Gradio debug UI at /ui (1 = on, 0 = off).
FLUX_UI=1
# Base URL the UI uses to call the API; defaults to http://127.0.0.1:{FLUX_PORT}/v1.
FLUX_UI_API_BASE=
# Run one small warmup generation at startup (1 = on, 0 = off).
FLUX_WARMUP=0
# Never hit the network when loading weights; requires `make download` first (1 = on, 0 = off).
FLUX_LOCAL_FILES_ONLY=1

# The workspace lives in iCloud Drive, which re-applies the macOS hidden flag to dot-prefixed
# paths and makes CPython skip hidden .pth files inside .venv. The `.nosync` suffix excludes
# the directory from iCloud sync, so the virtualenv must live at venv.nosync.
UV_PROJECT_ENVIRONMENT=venv.nosync
